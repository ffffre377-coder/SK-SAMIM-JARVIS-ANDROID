<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#0A5FFF"
                android:centerColor="#5BC0FF"
                android:endColor="#001722" />
        </shape>
    </item>
    <!-- Subtle vignette for premium feel -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="1200"
                android:centerX="0.5"
                android:centerY="0.6"
                android:startColor="#00000000"
                android:endColor="#22000000" />
        </shape>
    </item>
</layer-list>
